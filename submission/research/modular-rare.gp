{
fs=[7,10,12];
forprime(p=2,1000,
 for(j=1,#fs,
  f=fs[j];v=vector(p);
  for(r=1,p-1,
   t=Mod(r,p);
   if(t==1,next);
   if(f==7,c=t^2-t;b=t*c);
   if(f==10,den=t-(t-1)^2;if(den==0,next);c=(2*t^3-3*t^2+t)/den;b=c*t^2/den);
   if(f==12,c=(3*t^2-3*t+1)*(t-2*t^2)/(t-1)^3;b=c*(2*t-2*t^2-1)/(t-1));
   E=ellinit([1-c,-b,-b,0,0]);
   v[r+1]=if(#E,p+1-ellcard(E),0);
  );
  print(f," ",p," ",v);
 );
);
}
quit;
